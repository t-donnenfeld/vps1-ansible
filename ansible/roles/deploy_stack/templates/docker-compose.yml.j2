services:
  traefik:
    image: traefik:v3.6.14
    command:
      - --configFile=/etc/traefik/traefik.yml
    ports:
      - "80:80"
      - "443:443"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - {{ stack_dir }}/traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - {{ stack_dir }}/traefik/dynamic:/etc/traefik/dynamic:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - traefik_letsencrypt:/letsencrypt
    networks:
      - web
      - knowledge
    labels:
      - traefik.enable=true
      - traefik.http.routers.dashboard.rule=Host(`{{ subdomain_dashboard }}.{{ domain }}`)
      - traefik.http.routers.dashboard.entrypoints=websecure
      - traefik.http.routers.dashboard.tls.certresolver=letsencrypt
      - traefik.http.routers.dashboard.service=api@internal
      - traefik.http.routers.dashboard.middlewares=authelia@file

  postgres:
    image: postgres:16
    env_file:
      - .env
    environment:
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
      POSTGRES_USER: postgres
    volumes:
      - pgdata:/var/lib/postgresql/data
      - {{ stack_dir }}/postgres/init:/docker-entrypoint-initdb.d:ro
    networks:
      - internal

  authelia:
    image: "{{ authelia_image }}"
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:9091/api/health"]
      interval: 5s
      timeout: 3s
      retries: 12
    volumes:
      - {{ stack_dir }}/authelia/configuration.yml:/config/configuration.yml
      - {{ stack_dir }}/authelia/users_database.yml:/config/users_database.yml
      - {{ stack_dir }}/authelia/secrets:/secrets:ro
    networks:
      - web
      - internal
      - knowledge
    labels:
      - traefik.enable=true
      - traefik.docker.network=stack_web
      - traefik.http.routers.authelia.rule=Host(`{{ subdomain_auth }}.{{ domain }}`)
      - traefik.http.routers.authelia.entrypoints=websecure
      - traefik.http.routers.authelia.tls.certresolver=letsencrypt
      - traefik.http.services.authelia.loadbalancer.server.port=9091
      - traefik.http.routers.authelia.middlewares=authelia-cors@file
      # Define the basicauth and drop-headers middlewares at the entrypoint level
      - traefik.http.middlewares.drop-untrusted-auth-headers.headers.customrequestheaders.Remote-User=
      - traefik.http.middlewares.drop-untrusted-auth-headers.headers.customrequestheaders.Remote-Groups=
      - traefik.http.middlewares.drop-untrusted-auth-headers.headers.customrequestheaders.Remote-Name=
      - traefik.http.middlewares.drop-untrusted-auth-headers.headers.customrequestheaders.Remote-Email=

  vikunja:
    image: vikunja/vikunja:latest
    depends_on:
      postgres:
        condition: service_started
      authelia:
        condition: service_healthy
    env_file:
      - .env
    environment:
      VIKUNJA_DATABASE_TYPE: postgres
      VIKUNJA_DATABASE_HOST: postgres
      VIKUNJA_DATABASE_USER: "{{ vikunja_db_user }}"
      VIKUNJA_DATABASE_PASSWORD: "${VIKUNJA_DB_PASSWORD}"
      VIKUNJA_DATABASE_DATABASE: "{{ vikunja_db_name }}"
      VIKUNJA_SERVICE_PUBLICURL: "https://{{ subdomain_tasks }}.{{ domain }}/"
      # SMTP via Brevo
      VIKUNJA_MAILER_ENABLED: "true"
      VIKUNJA_MAILER_HOST: "${BREVO_SMTP_HOST}"
      VIKUNJA_MAILER_PORT: "${BREVO_SMTP_PORT}"
      VIKUNJA_MAILER_USERNAME: "${BREVO_SMTP_USER}"
      VIKUNJA_MAILER_PASSWORD: "${BREVO_SMTP_PASS}"
      VIKUNJA_MAILER_FROMEMAIL: "${MAIL_FROM}"
      OIDC_CLIENT_SECRET: "${OIDC_CLIENT_SECRET}"
      VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_CLIENTSECRET: "${OIDC_CLIENT_SECRET}"
    ports:
      - "127.0.0.1:3456:3456"
    volumes:
      - {{ stack_dir }}/vikunja/config.yml:/app/vikunja/config.yml:ro
      - {{ stack_dir }}/vikunja/files:/app/vikunja/files
    networks:
      - web
      - internal
      - knowledge
    labels:
      - traefik.enable=true
      - traefik.docker.network=stack_web
      # Routeur principal (frontend SPA + API)
      - traefik.http.routers.vikunja.rule=Host(`{{ subdomain_tasks }}.{{ domain }}`)
      - traefik.http.routers.vikunja.entrypoints=websecure
      - traefik.http.routers.vikunja.tls.certresolver=letsencrypt
      - traefik.http.services.vikunja.loadbalancer.server.port=3456
      # Optional: protect with Authelia at proxy level too:
      # - traefik.http.routers.vikunja.middlewares=authelia@file
      # Routeur CalDAV : priorité haute pour que /dav/* aille directement au backend
      # Google Calendar et autres clients CalDAV ne supportent pas Authelia/OIDC.
      # Ils s'authentifient via Basic Auth directement auprès de Vikunja.
      - traefik.http.routers.vikunja-dav.rule=Host(`{{ subdomain_tasks }}.{{ domain }}`) && PathPrefix(`/dav/`)
      - traefik.http.routers.vikunja-dav.entrypoints=websecure
      - traefik.http.routers.vikunja-dav.tls.certresolver=letsencrypt
      - traefik.http.routers.vikunja-dav.service=vikunja
      - traefik.http.routers.vikunja-dav.priority=100
      # HTTP -> HTTPS redirect
      - traefik.http.routers.vikunja-web.rule=Host(`{{ subdomain_tasks }}.{{ domain }}`)
      - traefik.http.routers.vikunja-web.entrypoints=web
      - traefik.http.routers.vikunja-web.middlewares=redirect-to-https@file
      - traefik.http.routers.vikunja-web.service=vikunja

  jellyfin:
    image: "{{ jellyfin_image }}"
    user: "1000:1000"
    networks:
      - web
      - knowledge
    volumes:
      - jellyfin_config:/config
      - jellyfin_cache:/cache
      - {{ jellyfin_media_dir | default('/mnt/media') }}:/media:ro
      - {{ stack_dir }}/jellyfin/SSO-Auth.xml:/config/plugins/configurations/SSO-Auth.xml:ro
    environment:
      JELLYFIN_PublishedServerUrl: "https://{{ subdomain_jellyfin }}.{{ domain }}"
    labels:
      - traefik.enable=true
      - traefik.docker.network=stack_web
      # Main router (Web UI) — OIDC via Authelia replaces forward auth
      # Users log in via Authelia SSO directly in Jellyfin (SSO-Auth plugin)
      - traefik.http.routers.jellyfin.rule=Host(`{{ subdomain_jellyfin }}.{{ domain }}`)
      - traefik.http.routers.jellyfin.entrypoints=websecure
      - traefik.http.routers.jellyfin.tls.certresolver=letsencrypt
      - traefik.http.services.jellyfin.loadbalancer.server.port=8096
      - traefik.http.routers.jellyfin.service=jellyfin
      # HTTP -> HTTPS redirect
      - traefik.http.routers.jellyfin-web.rule=Host(`{{ subdomain_jellyfin }}.{{ domain }}`)
      - traefik.http.routers.jellyfin-web.entrypoints=web
      - traefik.http.routers.jellyfin-web.middlewares=redirect-to-https@file
      - traefik.http.routers.jellyfin-web.service=jellyfin

  opencloud:
    image: "{{ opencloud_image }}"
    env_file:
      - .env
    environment:
      # OCIS_URL is REQUIRED: used by all internal services (web config.json server/theme URLs,
      # proxy OIDC issuer, reva gateway, etc.). Without it, the web frontend gets an empty
      # "server" field in config.json and shows "Missing or invalid config" error page.
      OCIS_URL: "https://{{ subdomain_cloud }}.{{ domain }}"
      OCIS_INSECURE: "false"
      # OIDC issuer: points to Authelia (external IDP) since we exclude the built-in IDP
      OCIS_OIDC_ISSUER: "{{ opencloud_oidc_issuer }}"
      # OIDC client_id for the whole ocis instance (used by proxy, web, and other services)
      OCIS_OIDC_CLIENT_ID: "{{ opencloud_client_id }}"
      # Web frontend OIDC config (ownCloud Web SPA — served by ocis web service at /config.json)
      WEB_OIDC_CLIENT_ID: "{{ opencloud_client_id }}"
      WEB_OIDC_AUTHORITY: "{{ opencloud_oidc_issuer }}"
      WEB_OIDC_METADATA_URL: "{{ opencloud_oidc_issuer }}/.well-known/openid-configuration"
      # Exclude built-in IDP since we use Authelia as external OIDC provider
      # OCIS_EXCLUDE_RUN_SERVICES: "idp" (re-enabled for user provisioning with external OIDC)
      OCIS_LOG_LEVEL: "info"
      OCIS_LOG_PRETTY: "true"
      # No TLS between Traefik and oCIS (Traefik handles TLS termination)
      PROXY_TLS: "false"
      # Content Security Policy: allow the ownCloud Web SPA to fetch OIDC config,
      # JWKS, and exchange tokens with the Authelia OIDC provider (auth.les12.fr).
      # Without this, the browser blocks fetch() calls to the OIDC provider's
      # token/userinfo endpoints due to connect-src CSP directive.
      PROXY_CSP_CONNECT_SRC: "'self' blob: https://raw.githubusercontent.com/owncloud/awesome-ocis/ https://{{ subdomain_auth }}.{{ domain }}"
      # Admin password for first login (overrides ocis init generated value)
      IDM_ADMIN_PASSWORD: "{{ opencloud_admin_password }}"
      # OpenCloud uses its own in-memory / embedded database by default.
      # For production, configure OC_STORE_DATASOURCE to point to Postgres.
      # See: https://owncloud.dev/ocis/deployment/
      # Explicit proxy OIDC configuration for external IDP (Authelia)
      # The proxy validates access tokens from Authelia for API requests.
      # The proxy reads client_id from OCIS_OIDC_CLIENT_ID / WEB_OIDC_CLIENT_ID.
      # PROXY_OIDC_CLIENT_ID is NOT a valid env var in ocis v8.x (silently ignored).
      PROXY_OIDC_ISSUER: "{{ opencloud_oidc_issuer }}"
      # Accept opaque access tokens from Authelia (validate via userinfo)
      PROXY_OIDC_ACCESS_TOKEN_VERIFY_METHOD: "none"
      PROXY_OIDC_INSECURE: "false"
      # Desktop/mobile clients: rewrite /.well-known/openid-configuration
      # to point to Authelia instead of the built-in IDP
      PROXY_OIDC_REWRITE_WELLKNOWN: "true"
      # Auto-provision accounts from OIDC claims (creates oCIS user on first login)
      PROXY_AUTOPROVISION_ACCOUNTS: "true"
      # Map OIDC claims to oCIS user attributes
      PROXY_USER_OIDC_CLAIM: "preferred_username"
      PROXY_USER_CS3_CLAIM: "username"
    # Run ocis init on first startup to generate mandatory secrets (jwt_secret,
    # machine auth API key, transfer secret, service user passwords, etc.).
    # The || true allows subsequent restarts where ocis.yaml already exists.
    # NOTE: ocis is a Go binary with no shell. We must override entrypoint to
    # use /bin/sh -c so that the init command runs before ocis server.
    # WHY --insecure: Prevents interactive prompt "Do you want to configure
    # Infinite Scale with certificate checking disabled?" when OC_INSECURE
    # is set to "false" (default). The prompt would block container startup.
    # WHY --admin-password: Uses the IDM_ADMIN_PASSWORD env var to set the
    # admin password during init, rather than a randomly generated one.
    entrypoint: ["/bin/sh", "-c"]
    command: ["ocis init --insecure --admin-password ${IDM_ADMIN_PASSWORD} || true; exec ocis server"]
    volumes:
      - opencloud_data:/var/lib/ocis
      - opencloud_config:/etc/ocis
    networks:
      - web
      - internal
      - knowledge
    depends_on:
      - authelia
    restart: unless-stopped
    labels:
      - traefik.enable=true
      - traefik.docker.network=stack_web
      - traefik.http.routers.opencloud.rule=Host(`{{ subdomain_cloud }}.{{ domain }}`)
      - traefik.http.routers.opencloud.entrypoints=websecure
      - traefik.http.routers.opencloud.tls.certresolver=letsencrypt
      - traefik.http.services.opencloud.loadbalancer.server.port=9200
      - traefik.http.routers.opencloud.service=opencloud
      - traefik.http.routers.opencloud.middlewares=opencloud-csp@file
      # No Authelia forward auth middleware — OIDC is handled directly by OpenCloud
      # HTTP -> HTTPS redirect
      - traefik.http.routers.opencloud-web.rule=Host(`{{ subdomain_cloud }}.{{ domain }}`)
      - traefik.http.routers.opencloud-web.entrypoints=web
      - traefik.http.routers.opencloud-web.middlewares=redirect-to-https@file
      - traefik.http.routers.opencloud-web.service=opencloud


  syncthing:
    image: "{{ syncthing_image }}"
    user: "1000:1000"
    volumes:
      - {{ stack_dir }}/syncthing/config:/var/syncthing/config
      - {{ stack_dir }}/syncthing/data:/var/syncthing/data
      - {{ obsidian_vaults_dir }}:/var/syncthing/vaults
    networks:
      - web
      - knowledge
    restart: unless-stopped
    depends_on:
      - authelia
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8384/"]
      interval: 30s
      timeout: 10s
      retries: 3
    labels:
      - traefik.enable=true
      - traefik.docker.network=stack_web
      - traefik.http.routers.syncthing.rule=Host(`{{ subdomain_syncthing }}.{{ domain }}`)
      - traefik.http.routers.syncthing.entrypoints=websecure
      - traefik.http.routers.syncthing.tls.certresolver=letsencrypt
      - traefik.http.services.syncthing.loadbalancer.server.port=8384
      - traefik.http.routers.syncthing.middlewares=authelia@file
      # HTTP -> HTTPS redirect
      - traefik.http.routers.syncthing-web.rule=Host(`{{ subdomain_syncthing }}.{{ domain }}`)
      - traefik.http.routers.syncthing-web.entrypoints=web
      - traefik.http.routers.syncthing-web.middlewares=redirect-to-https@file
      - traefik.http.routers.syncthing-web.service=syncthing

  # OpenClaw is now installed directly on the host (not in Docker).
  # Traefik routes claw.les12.fr to host.docker.internal:{{ openclaw_gateway_port | default(18789) }} via file-based config.

  rmfakecloud:
    image: "{{ rmfakecloud_image }}"
    container_name: rmfakecloud
    restart: unless-stopped
    ports:
      - "127.0.0.1:3000:3000"
    volumes:
      - rmfakecloud_data:/data
      - /usr/bin/busybox:/healthcheck/busybox:ro
    healthcheck:
      test: ["CMD", "/healthcheck/busybox", "wget", "-q", "-O", "/dev/null", "http://localhost:3000/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    environment:
      JWT_SECRET_KEY: "{{ rmfakecloud_jwt_secret }}"
      PORT: "3000"
      RM_TRUST_PROXY: "true"
      RM_HTTPS_COOKIE: "true"
    networks:
      - web
    labels:
      - traefik.enable=true
      - traefik.docker.network=stack_web
      - traefik.http.routers.rmfakecloud.rule=Host(`{{ subdomain_rmfakecloud }}.{{ domain }}`)
      - traefik.http.routers.rmfakecloud.entrypoints=websecure
      - traefik.http.routers.rmfakecloud.tls.certresolver=letsencrypt
      - traefik.http.services.rmfakecloud.loadbalancer.server.port=3000
      # No authentication middleware — reMarkable tablet sync client cannot handle forward auth.
      # rmfakecloud handles its own device and user authentication internally.
      # HTTP -> HTTPS redirect
      - traefik.http.routers.rmfakecloud-web.rule=Host(`{{ subdomain_rmfakecloud }}.{{ domain }}`)
      - traefik.http.routers.rmfakecloud-web.entrypoints=web
      - traefik.http.routers.rmfakecloud-web.middlewares=redirect-to-https@file
      - traefik.http.routers.rmfakecloud-web.service=rmfakecloud

  signal:
    image: "{{ signal_image }}"
    container_name: "{{ signal_container_name | default('signal-cli-rest-api') }}"
    ports:
      - "127.0.0.1:8088:8080"
    volumes:
      - signal_data:/home/.local/share/signal-cli
    networks:
      - knowledge
    environment:
      MODE: "json-rpc"
    restart: unless-stopped

volumes:
  traefik_letsencrypt:
  pgdata:
  # Named vikunja_files removed (using host bind mount instead)
  jellyfin_config:
  jellyfin_cache:
  signal_data:
  opencloud_data:
  opencloud_config:
  rmfakecloud_data:

networks:
  web:
  internal:
  knowledge:
    driver: bridge
    internal: false
