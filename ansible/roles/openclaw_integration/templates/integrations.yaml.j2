# OpenClaw Service Integrations
# Generated by Ansible — runtime bridge config for service-to-service communication
# This file is consumed by OpenClaw's webhook handler and tool system.
#
# OpenClaw runs directly on the host (not in Docker), so it accesses services
# via localhost with published Docker ports (127.0.0.1 only).

services:
  syncthing:
    url: http://127.0.0.1:8384
    description: Syncthing device synchronization API
    api_key: {{ syncthing_api_key | default('') }}
    endpoints:
      system: http://127.0.0.1:8384/rest/system/status
      config: http://127.0.0.1:8384/rest/system/config
      connections: http://127.0.0.1:8384/rest/system/connections
      folders: http://127.0.0.1:8384/rest/db/status
      events: http://127.0.0.1:8384/rest/events
      metrics: http://127.0.0.1:8384/metrics
    dashboard_url: https://{{ subdomain_syncthing }}.{{ domain }}

  vikunja:
    url: http://127.0.0.1:3456
    description: Vikunja task management API
    api_token: {{ vikunja_api_token | default('') }}
    api_version: v1
    endpoints:
      info: http://127.0.0.1:3456/api/v1/info
      tasks: http://127.0.0.1:3456/api/v1/tasks
      projects: http://127.0.0.1:3456/api/v1/projects
      labels: http://127.0.0.1:3456/api/v1/labels
      teams: http://127.0.0.1:3456/api/v1/teams
      users: http://127.0.0.1:3456/api/v1/user
    dashboard_url: https://{{ subdomain_tasks }}.{{ domain }}

  jellyfin:
    url: http://127.0.0.1:8096
    description: Jellyfin media streaming
    auth: none
    endpoints:
      api: http://127.0.0.1:8096
      health: http://127.0.0.1:8096/health
      system: http://127.0.0.1:8096/system/ping
    dashboard_url: https://{{ subdomain_jellyfin }}.{{ domain }}

  signal:
    url: http://127.0.0.1:8088
    description: Signal Messenger REST API (signal-cli-rest-api, internal only)
    auth: none
    public_url: null
    endpoints:
      register: http://127.0.0.1:8088/v1/register/{number}
      verify: http://127.0.0.1:8088/v1/register/{number}/verify/{token}
      send: http://127.0.0.1:8088/v2/send
      receive: http://127.0.0.1:8088/v1/receive/{number}
      devices: http://127.0.0.1:8088/v1/devices/{number}
      health: http://127.0.0.1:8088/health
    dashboard_url: null

  opencloud:
    url: http://127.0.0.1:9200
    description: OpenCloud (ownCloud Infinite Scale) cloud storage and collaboration
    auth: none
    endpoints:
      api: http://127.0.0.1:9200
      health: http://127.0.0.1:9200/health
      webdav: http://127.0.0.1:9200/remote.php/dav
    dashboard_url: https://{{ subdomain_cloud }}.{{ domain }}

  rmfakecloud:
    url: http://127.0.0.1:3000
    description: rmfakecloud — self-hosted reMarkable cloud sync server
    auth: none
    endpoints:
      api: http://127.0.0.1:3000
      health: http://127.0.0.1:3000/health
    dashboard_url: https://{{ subdomain_rmfakecloud }}.{{ domain }}


