# OpenClaw router — file-based config for Traefik
# Generated by Ansible
# OpenClaw runs directly on the host (not in Docker) at 127.0.0.1:{{ openclaw_gateway_port | default(18789) }}
http:
  routers:
    openclaw:
      rule: "Host(`{{ subdomain_openclaw }}.{{ domain }}`)"
      entryPoints:
        - websecure
      service: openclaw
      tls:
        certResolver: letsencrypt
      middlewares:
        - authelia@file

    openclaw-web:
      rule: "Host(`{{ subdomain_openclaw }}.{{ domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https@file
      service: openclaw

  services:
    openclaw:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:{{ openclaw_gateway_port }}"
        passHostHeader: true

