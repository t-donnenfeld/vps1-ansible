# OpenClaw systemd service — runs directly on the host (not in Docker)
# Generated by Ansible
[Unit]
Description=OpenClaw AI Gateway and Agent Service
Documentation=https://github.com/openclaw/openclaw
After=network.target docker.service
Requires=docker.service
Wants=stack.service

[Service]
Type=simple
User=1000
Group=1000
WorkingDirectory={{ openclaw_install_dir }}

# Environment variables for service discovery
Environment=JAVA_HOME={{ openclaw_java_home | default('/usr/lib/jvm/java-25-openjdk-amd64') }}
Environment=OPENCLAW_DATA_DIR={{ openclaw_install_dir }}/data
Environment=OPENCLAW_GATEWAY_TOKEN={{ openclaw_gateway_token | default('') }}
Environment=VIKUNJA_URL=http://127.0.0.1:3456
Environment=JELLYFIN_URL=http://127.0.0.1:8096
Environment=JELLYFIN_API_KEY={{ jellyfin_api_key | default('') }}
Environment=OPENCLOUD_URL=http://127.0.0.1:9200
Environment=VIKUNJA_API_TOKEN={{ vikunja_api_token | default('') }}
Environment=DEEPSEEK_API_KEY={{ deepseek_api_key | default('') }}
Environment=SIGNAL_URL=http://127.0.0.1:8088

# OpenClaw config file path (overrides default search paths)
# OPENCLAW_CONFIG_PATH points to the config FILE, not directory
Environment=OPENCLAW_CONFIG_PATH={{ openclaw_install_dir }}/config/openclaw.json

# Use globally installed openclaw binary (npm install -g openclaw)
# The gateway reads config from OPENCLAW_CONFIG_PATH
# Config is managed externally (rendered by Ansible), no setup needed
ExecStart=/usr/bin/openclaw gateway

# Restart policy
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths={{ openclaw_install_dir }}

[Install]
WantedBy=multi-user.target

