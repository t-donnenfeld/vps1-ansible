[DEFAULT]
bantime = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
backend = systemd
banaction = ufw
destemail = {{ email_admin }}
sender = {{ fail2ban_sender }}
mta = sendmail
ignoreip = {{ fail2ban_ignoreip | default('127.0.0.1/8 ::1') }}
action = %(action_mwl)s

[sshd]
enabled = true
port = {{ ssh_port }}
logpath = %(sshd_log)s
